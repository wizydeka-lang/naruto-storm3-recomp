+// Constant names come from the game's constant tables and become macros, so a
+// name that is also an HLSL intrinsic (Naruto has a constant named clip)
+// would replace that intrinsic. Such names get a c_ prefix; the returned
+// pointer stays valid for the thread's lifetime.
+static const char* hlslSafeConstantName(const char* name)
+{
+    static const std::set<std::string_view> intrinsics = {
+        "abs", "clamp", "clip", "cos", "cross", "ddx", "ddy", "degrees", "distance", "dot",
+        "exp", "exp2", "floor", "fmod", "frac", "length", "lerp", "lit", "log", "log2", "max",
+        "min", "mul", "normalize", "pow", "radians", "reflect", "refract", "round", "rsqrt",
+        "saturate", "select", "sign", "sin", "smoothstep", "sqrt", "step", "tan", "trunc" };
+    if (!intrinsics.count(name))
+        return name;
+    thread_local std::map<std::string, std::string> renamed;
+    auto& safe = renamed.try_emplace(name, std::string("c_") + name).first->second;
+    return safe.c_str();
+}
