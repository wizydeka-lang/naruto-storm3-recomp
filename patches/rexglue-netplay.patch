@@ -23,6 +30,141 @@ using namespace rex::system;
 
 XgiApp::XgiApp(KernelState* kernel_state) : App(kernel_state, 0xFB) {}
 
+namespace {
+
+namespace np = rex::kernel::xam::netplay;
+
+// With netplay on: the sessions this copy has created or joined, by the
+// object XamSessionRefObjByHandle gave for each.
+struct LocalSession {
+  np::Session session;
+  bool host = false;
+  uint64_t nonce = 0;
+  uint32_t state = 0;  // XSESSION_STATE: lobby, registration, in game, reporting
+  uint32_t members = 0;
+  std::vector<uint64_t> remote_xuids;
+};
+std::mutex sessions_mutex;
+std::map<uint32_t, LocalSession> sessions;
+std::vector<np::Session> found_sessions;
+std::map<uint32_t, uint32_t> user_contexts;
+
+constexpr uint32_t kSearchResultSize = 92;  // XSESSION_SEARCHRESULT
+constexpr uint32_t kPropertySize = 24;      // XUSER_PROPERTY
+constexpr uint32_t kContextSize = 8;        // XUSER_CONTEXT
+constexpr uint32_t kLocalDetailsSize = 128;  // XSESSION_LOCAL_DETAILS
+constexpr uint32_t kMemberSize = 16;         // XSESSION_MEMBER
+
+// Advertises the hosted session searches should find: the latest one using
+// matchmaking (XSESSION_CREATE_USES_MATCHMAKING), else the latest hosted.
+// sessions_mutex is held.
+void Advertise() {
+  const LocalSession* best = nullptr;
+  for (const auto& [object, local] : sessions) {
+    if (local.host && (!best || (local.session.flags & 8) >= (best->session.flags & 8))) {
+      best = &local;
+    }
+  }
+  if (!best) {
+    np::StopHosting();
+    return;
+  }
+  np::Session advertised = best->session;
+  advertised.filled_public = std::min(best->members, advertised.max_public);
+  np::Host(advertised);
+}
+
+// The numeric properties a search result can carry (strings and binary
+// data would need more room).
+bool NumericProperty(const np::Property& property) {
+  uint32_t type = property.id >> 28;
+  return (type == 1 || type == 2 || type == 3 || type == 5 || type == 7) &&
+         property.value.size() <= 8;
+}
+
+uint32_t ResultExtraSize(const np::Session& session) {
+  uint32_t properties = uint32_t(std::count_if(session.properties.begin(),
+                                               session.properties.end(), NumericProperty));
+  return properties * kPropertySize + uint32_t(session.contexts.size()) * kContextSize;
+}
+
+// XSessionSearch: asks the lobby, then writes an XSESSION_SEARCHRESULT_HEADER
+// and the sessions with open slots at results_ptr. Without room, stores the
+// size needed in the message (its results size field) instead.
+X_HRESULT SearchSessions(memory::Memory* memory, uint8_t* size_field, uint32_t max_results,
+                         uint32_t results_size, uint32_t results_ptr) {
+  std::vector<np::Session> found;
+  for (np::Session& session : np::Search()) {
+    if (session.filled_public < session.max_public && found.size() < max_results) {
+      found.push_back(std::move(session));
+    }
+  }
+  {
+    std::lock_guard<std::mutex> lock(sessions_mutex);
+    found_sessions = found;
+  }
+  uint32_t needed = 8;
+  for (const np::Session& session : found) {
+    needed += kSearchResultSize + ResultExtraSize(session);
+  }
+  if (!results_ptr || results_size < 8) {
+    memory::store_and_swap<uint32_t>(size_field, std::max<uint32_t>(needed, 8 + kSearchResultSize));
+    REX_NETPLAY_LOG("XSessionSearch: {} found, needs {} bytes", found.size(), needed);
+    return X_ERROR_INSUFFICIENT_BUFFER;
+  }
+  // As many results as fit.
+  uint32_t count = 0, used = 8;
+  while (count < found.size() &&
+         used + kSearchResultSize + ResultExtraSize(found[count]) <= results_size) {
+    used += kSearchResultSize + ResultExtraSize(found[count]);
+    ++count;
+  }
+  uint8_t* header = memory->TranslateVirtual<uint8_t*>(results_ptr);
+  std::memset(header, 0, used);
+  uint32_t results = results_ptr + 8;
+  uint32_t extra = results + count * kSearchResultSize;
+  memory::store_and_swap<uint32_t>(header + 0, count);
+  memory::store_and_swap<uint32_t>(header + 4, count ? results : 0);
+  for (uint32_t i = 0; i < count; ++i) {
+    const np::Session& session = found[i];
+    uint8_t* result = memory->TranslateVirtual<uint8_t*>(results + i * kSearchResultSize);
+    std::memcpy(result, session.info, np::kSessionInfoSize);
+    memory::store_and_swap<uint32_t>(result + 60, session.max_public - session.filled_public);
+    memory::store_and_swap<uint32_t>(
+        result + 64, session.max_private - std::min(session.filled_private, session.max_private));
+    memory::store_and_swap<uint32_t>(result + 68, session.filled_public);
+    memory::store_and_swap<uint32_t>(result + 72, session.filled_private);
+    uint32_t properties_ptr = extra, property_count = 0;
+    for (const np::Property& property : session.properties) {
+      if (!NumericProperty(property)) {
+        continue;
+      }
+      uint8_t* out = memory->TranslateVirtual<uint8_t*>(extra);
+      memory::store_and_swap<uint32_t>(out + 0, property.id);
+      out[8] = uint8_t(property.id >> 28);  // XUSER_DATA type
+      std::memcpy(out + 16, property.value.data(), property.value.size());
+      extra += kPropertySize;
+      ++property_count;
+    }
+    uint32_t contexts_ptr = extra;
+    for (const auto& [id, value] : session.contexts) {
+      uint8_t* out = memory->TranslateVirtual<uint8_t*>(extra);
+      memory::store_and_swap<uint32_t>(out + 0, id);
+      memory::store_and_swap<uint32_t>(out + 4, value);
+      extra += kContextSize;
+    }
+    memory::store_and_swap<uint32_t>(result + 76, property_count);
+    memory::store_and_swap<uint32_t>(result + 80, uint32_t(session.contexts.size()));
+    memory::store_and_swap<uint32_t>(result + 84, property_count ? properties_ptr : 0);
+    memory::store_and_swap<uint32_t>(result + 88, session.contexts.empty() ? 0 : contexts_ptr);
+  }
+  REX_NETPLAY_LOG("XSessionSearch: returned {} of {} sessions ({} bytes of {})", count,
+                  found.size(), used, results_size);
+  return X_E_SUCCESS;
+}
+
