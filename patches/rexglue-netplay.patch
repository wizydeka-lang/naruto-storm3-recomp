+    XNQOSINFO& info = infos[i];
+    // XNET_XNQOSINFO_COMPLETE, TARGET_CONTACTED and DATA_RECEIVED.
+    info.flags = uint8_t(contacted[i] ? (0x01 | 0x02 | (data[i].empty() ? 0 : 0x08)) : 0x01);
+    info.probes_xmit = uint16_t(probes);
+    info.probes_recv = uint16_t(contacted[i] ? probes : 0);
+    if (!data[i].empty()) {
+      std::memcpy(qos + data_at, data[i].data(), data[i].size());
+      info.data_ptr = qos_guest + data_at;
+      info.data_len = uint16_t(data[i].size());
+      data_at += uint32_t(data[i].size());
