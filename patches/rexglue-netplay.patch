+  uint32_t qos_guest = REX_KERNEL_MEMORY()->SystemHeapAlloc(header + data_total);
+  auto* qos = REX_KERNEL_MEMORY()->TranslateVirtual<uint8_t*>(qos_guest);
+  std::memset(qos, 0, header + data_total);
+  auto* table = reinterpret_cast<XNQOS*>(qos);
+  table->count = count;
+  table->count_pending = 0;
+  auto* infos = reinterpret_cast<XNQOSINFO*>(qos + 8);
+  uint32_t data_at = header;
