+namespace {
+// With netplay on, logs the first few of each kind of message: some are
+// polled every frame.
+void LogMessage(uint32_t app_id, uint32_t message, uint32_t buffer_ptr, uint32_t buffer_length,
+                X_HRESULT result) {
+  if (!REXCVAR_GET(netplay)) {
+    return;
+  }
+  static std::mutex mutex;
+  static std::map<uint64_t, uint32_t> counts;
+  {
+    std::lock_guard<std::mutex> lock(mutex);
+    if (counts[(uint64_t(app_id) << 32) | message]++ >= 4) {
+      return;
+    }
+  }
+  REX_NETPLAY_LOG("app {:02X} message {:08X} (buffer {:08X}, length {:08X}) -> {:08X}", app_id,
+                  message, buffer_ptr, buffer_length, uint32_t(result));
+}
