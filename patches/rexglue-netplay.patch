+namespace {
+
+// Sockets are kernel objects here, with handles like 0xF80001FC, but on the
+// console a SOCKET is a small positive number and games check for that (a
+// negative one is taken as INVALID_SOCKET). The guest sees the handle without
+// its high bits.
+constexpr uint32_t kSocketHandleBits = 0xF8000000;
+
+uint32_t GuestSocket(uint32_t handle) {
+  return (handle & kSocketHandleBits) == kSocketHandleBits ? handle & ~kSocketHandleBits : handle;
+}
+
+rex::system::object_ref<rex::system::XSocket> LookupSocket(uint32_t socket) {
+  if (socket == 0xFFFFFFFF) {
+    return nullptr;
+  }
+  if ((socket & kSocketHandleBits) == 0) {
+    socket |= kSocketHandleBits;
+  }
+  return REX_KERNEL_OBJECTS()->LookupObject<rex::system::XSocket>(socket);
+}
+
+// Sets the guest's last error (a Winsock code) from the host's socket error,
+// so a non-blocking socket's "would block" and the like read as on Windows.
+void SetSocketError() {
+#if REX_PLATFORM_WIN32
+  rex::system::XThread::SetLastError(uint32_t(WSAGetLastError()));
+#else
+  uint32_t code;
+  switch (errno) {
+    case EWOULDBLOCK:
+#if EAGAIN != EWOULDBLOCK
+    case EAGAIN:
+#endif
+    case EINPROGRESS:  // a non-blocking connect is WSAEWOULDBLOCK in Winsock
+      code = 10035;
+      break;
+    case EALREADY: code = 10037; break;
+    case ENOTSOCK: code = 10038; break;
+    case EMSGSIZE: code = 10040; break;
+    case EADDRINUSE: code = 10048; break;
+    case EADDRNOTAVAIL: code = 10049; break;
+    case ENETDOWN: code = 10050; break;
+    case ENETUNREACH: code = 10051; break;
+    case ECONNABORTED: code = 10053; break;
+    case ECONNRESET: code = 10054; break;
+    case ENOBUFS: code = 10055; break;
+    case EISCONN: code = 10056; break;
+    case ENOTCONN: code = 10057; break;
+    case ESHUTDOWN: code = 10058; break;
+    case ETIMEDOUT: code = 10060; break;
+    case ECONNREFUSED: code = 10061; break;
+    case EHOSTUNREACH: code = 10065; break;
+    case EINTR: code = 10004; break;
+    case EFAULT: code = 10014; break;
+    default: code = 10022; break;  // WSAEINVAL
+  }
+  rex::system::XThread::SetLastError(code);
+#endif
+}
