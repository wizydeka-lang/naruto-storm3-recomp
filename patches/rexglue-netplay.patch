index 0000000..5b85075
--- /dev/null
+++ b/include/rex/kernel/xam/netplay.h
@@ -0,0 +1,126 @@
+/**
+ * @file        rex/kernel/xam/netplay.h
+ * @brief       Online play without Xbox Live
+ *
+ * With the netplay cvar on, player 1 is reported as signed in to Xbox Live,
+ * so a game's online modes open, and Live's matchmaking is replaced by a
+ * small peer-to-peer lobby:
+ *
+ * - Each copy has a unique online XUID and title address (XNADDR) holding
+ *   its real IPv4 address, so the game's XNADDR to IN_ADDR lookups give real
+ *   addresses and its own traffic goes straight between the two.
+ * - A copy hosting a session answers lobby queries (UDP, netplay_port) with
+ *   the session, the host's contexts and properties and its QoS data. A
+ *   session search asks netplay_peer and broadcasts on the local network.
+ * - The game's socket ports are moved up by netplay_port_offset (Xbox games
+ *   use ports below 1024, which need root elsewhere).
+ *
+ * Calls into networking, sessions and Live are logged with a [netplay]
+ * prefix.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include <fmt/format.h>
+
+#include <rex/hook.h>
+#include <rex/logging.h>
+#include <rex/system/flags.h>
+
+#define REX_NETPLAY_LOG(...)                                  \
+  do {                                                        \
+    if (REXCVAR_GET(netplay)) {                               \
+      REXKRNL_INFO("[netplay] {}", fmt::format(__VA_ARGS__)); \
+    }                                                         \
+  } while (0)
+
+// An unimplemented export that, with netplay on, logs its first six
+// arguments and caller instead of the usual stub warning. Like REX_STUB it
+// leaves r3 as it was.
+#define REX_EXPORT_NETPLAY_TRACE(name)                                                         \
+  extern "C" REX_FUNC(name) {                                                                  \
+    (void)base;                                                                                \
+    if (REXCVAR_GET(netplay)) {                                                                \
+      REXKRNL_INFO("[netplay] {}({:08X}, {:08X}, {:08X}, {:08X}, {:08X}, {:08X}) from {:08X}", \
+                   #name, ctx.r3.u32, ctx.r4.u32, ctx.r5.u32, ctx.r6.u32, ctx.r7.u32,           \
+                   ctx.r8.u32, uint32_t(ctx.lr));                                              \
+    } else {                                                                                   \
+      REXKRNL_WARN("{} STUB", #name);                                                          \
+    }                                                                                          \
+  }                                                                                            \
+  static rex::ppc::detail::PPCFuncRegistrar _ppc_reg_##name(#name, &name);
+
+namespace rex::kernel::xam::netplay {
+
+// Guest structure sizes: XNADDR, XNKID, XNKEY and XSESSION_INFO (an XNKID,
+// the host's XNADDR and an XNKEY).
+constexpr size_t kXnAddrSize = 36;
+constexpr size_t kXnKidSize = 8;
+constexpr size_t kXnKeySize = 16;
+constexpr size_t kSessionInfoSize = kXnKidSize + kXnAddrSize + kXnKeySize;
+
+inline bool Enabled() {
+  return REXCVAR_GET(netplay);
+}
+
+// This copy's IPv4 address (host order), as the peer reaches it.
+uint32_t LocalIp();
+// This copy's XNADDR, as the guest lays it out.
+void FillXnAddr(uint8_t* xnaddr);
+// The IPv4 address (host order) in a guest XNADDR.
+uint32_t XnAddrIp(const uint8_t* xnaddr);
+// This copy's online XUID: unique per run, for sessions and the game's own
+// traffic (saves stay under the profile's own XUID).
+uint64_t OnlineXuid();
+// A 64-bit value no other copy will pick, for session ids, keys and nonces.
+uint64_t Random64();
+
+// The host socket port for a guest one, and back.
+uint16_t HostPort(uint16_t guest_port);
+uint16_t GuestPort(uint16_t host_port);
+
+// Player 1's contexts and properties (XUserSetContext / XUserSetProperty),
+// which a hosted session advertises. Property values are as the guest
+// stores them (big-endian).
+void SetContext(uint32_t id, uint32_t value);
+void SetProperty(uint32_t id, const uint8_t* value, uint32_t size);
+// Data the host attached with XNetQosListen.
+void SetQosData(const uint8_t* data, uint32_t size);
+
+struct Property {
+  uint32_t id = 0;
+  std::vector<uint8_t> value;  // big-endian, as the guest stores it
+};
+
+// A session, as hosted here or as found by a search.
+struct Session {
+  uint8_t info[kSessionInfoSize] = {};  // XSESSION_INFO, guest layout
+  uint32_t flags = 0;
+  uint32_t max_public = 0, max_private = 0;
+  uint32_t filled_public = 0, filled_private = 0;
+  std::vector<std::pair<uint32_t, uint32_t>> contexts;
+  std::vector<Property> properties;
+  std::vector<uint8_t> qos;
+};
+
+// Starts advertising a session (replacing any other), updates how many
+// slots it has filled, or stops.
+void Host(const Session& session);
+void SetFilledSlots(uint32_t filled_public, uint32_t filled_private);
+void StopHosting();
+
+// Sessions hosted by netplay_peer or on the local network, waiting up to
+// about a second for answers.
+std::vector<Session> Search();
+// The QoS data of a session found by the last search, by its host address.
+bool FoundQosData(uint32_t host_ip, std::vector<uint8_t>* data);
+
+// XNADDRs seen (searches, lookups), to map IN_ADDRs back to them.
+void RememberXnAddr(const uint8_t* xnaddr);
+bool XnAddrForIp(uint32_t ip, uint8_t* xnaddr);
+
+}  // namespace rex::kernel::xam::netplay
