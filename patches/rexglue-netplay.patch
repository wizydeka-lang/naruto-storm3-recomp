diff --git a/src/kernel/xam/netplay.cpp b/src/kernel/xam/netplay.cpp
new file mode 100644
index 0000000..0da28f8
--- /dev/null
+++ b/src/kernel/xam/netplay.cpp
@@ -0,0 +1,464 @@
+/**
+ * @file        kernel/xam/netplay.cpp
+ * @brief       Online play without Xbox Live (see rex/kernel/xam/netplay.h)
+ */
+
+#include <rex/kernel/xam/netplay.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstring>
+#include <mutex>
+#include <random>
+#include <thread>
+#include <unordered_map>
+
+#include <rex/cvar.h>
+#include <rex/platform.h>
+
+#if REX_PLATFORM_WIN32
+#include <winsock2.h>  // NOLINT(build/include_order)
+#include <ws2tcpip.h>  // NOLINT(build/include_order)
+using socket_t = SOCKET;
+#define NETPLAY_CLOSE closesocket
+#else
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <unistd.h>
+using socket_t = int;
+#define NETPLAY_CLOSE close
+#endif
+
+REXCVAR_DEFINE_BOOL(netplay, false, "Netplay",
+                    "Online play without Xbox Live: player 1 is signed in to Live and sessions "
+                    "are found through netplay_peer or the local network");
+REXCVAR_DEFINE_STRING(netplay_peer, "", "Netplay",
+                      "IPv4 address of the other player's machine, asked first when searching "
+                      "for sessions (sessions on the local network are found without it)");
+REXCVAR_DEFINE_UINT32(netplay_port, 36000, "Netplay",
+                      "UDP port where hosted sessions answer searches");
+REXCVAR_DEFINE_UINT32(netplay_port_offset, 36000, "Netplay",
+                      "Added to the game's own socket ports (Xbox games use ports below 1024)");
+
+namespace rex::kernel::xam::netplay {
+
+namespace {
+
+constexpr uint8_t kQuery[4] = {'N', 'R', 'Q', '1'};
+constexpr uint8_t kAnswer[4] = {'N', 'R', 'S', '1'};
+
+std::string IpText(uint32_t ip) {
+  return fmt::format("{}.{}.{}.{}", ip >> 24, (ip >> 16) & 0xFF, (ip >> 8) & 0xFF, ip & 0xFF);
+}
+
+uint32_t ParseIp(const std::string& text) {
+  in_addr address{};
+  if (text.empty() || inet_pton(AF_INET, text.c_str(), &address) != 1) {
+    return 0;
+  }
+  return ntohl(address.s_addr);
+}
+
+sockaddr_in SocketAddress(uint32_t ip, uint16_t port) {
+  sockaddr_in address{};
+  address.sin_family = AF_INET;
+  address.sin_addr.s_addr = htonl(ip);
+  address.sin_port = htons(port);
+  return address;
+}
+
+// Winsock must be started before the lobby's own sockets are opened, which can
+// happen before the guest calls WSAStartup. Extra calls are reference counted.
+socket_t OpenUdpSocket() {
+#if REX_PLATFORM_WIN32
+  static const bool started = [] {
+    WSADATA data{};
+    return WSAStartup(MAKEWORD(2, 2), &data) == 0;
+  }();
+  (void)started;
+#endif
+  return socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+}
+
+void SetReceiveTimeout(socket_t s, int milliseconds) {
+#if REX_PLATFORM_WIN32
+  DWORD timeout = milliseconds;
+#else
+  timeval timeout{milliseconds / 1000, (milliseconds % 1000) * 1000};
+#endif
+  setsockopt(s, SOL_SOCKET, SO_RCVTIMEO, reinterpret_cast<const char*>(&timeout),
+             sizeof(timeout));
+}
+
+// Big-endian writers and readers for the lobby messages.
+void Put16(std::vector<uint8_t>& out, uint16_t value) {
+  out.push_back(uint8_t(value >> 8));
+  out.push_back(uint8_t(value));
+}
+void Put32(std::vector<uint8_t>& out, uint32_t value) {
+  Put16(out, uint16_t(value >> 16));
+  Put16(out, uint16_t(value));
+}
+struct Reader {
+  const uint8_t* data;
+  size_t size, at = 0;
+  bool ok = true;
+  bool Take(void* out, size_t count) {
+    if (!ok || size - at < count) {
+      ok = false;
+      return false;
+    }
+    std::memcpy(out, data + at, count);
+    at += count;
+    return true;
+  }
+  uint16_t Get16() {
+    uint8_t b[2] = {};
+    Take(b, 2);
+    return uint16_t((b[0] << 8) | b[1]);
+  }
+  uint32_t Get32() {
+    uint32_t high = Get16();
+    return (high << 16) | Get16();
+  }
+};
+
+std::vector<uint8_t> Encode(const Session& session) {
+  std::vector<uint8_t> out(kAnswer, kAnswer + 4);
+  out.insert(out.end(), session.info, session.info + kSessionInfoSize);
+  Put32(out, session.flags);
+  Put32(out, session.max_public);
+  Put32(out, session.max_private);
+  Put32(out, session.filled_public);
+  Put32(out, session.filled_private);
+  Put16(out, uint16_t(session.contexts.size()));
+  for (const auto& [id, value] : session.contexts) {
+    Put32(out, id);
+    Put32(out, value);
+  }
+  Put16(out, uint16_t(session.properties.size()));
+  for (const Property& property : session.properties) {
+    Put32(out, property.id);
+    Put16(out, uint16_t(property.value.size()));
+    out.insert(out.end(), property.value.begin(), property.value.end());
+  }
+  Put16(out, uint16_t(session.qos.size()));
+  out.insert(out.end(), session.qos.begin(), session.qos.end());
+  return out;
+}
+
+bool Decode(const uint8_t* data, size_t size, Session* session) {
+  Reader in{data, size};
+  uint8_t magic[4];
+  if (!in.Take(magic, 4) || std::memcmp(magic, kAnswer, 4) != 0) {
+    return false;
+  }
+  in.Take(session->info, kSessionInfoSize);
+  session->flags = in.Get32();
+  session->max_public = in.Get32();
+  session->max_private = in.Get32();
+  session->filled_public = in.Get32();
+  session->filled_private = in.Get32();
+  for (uint16_t i = 0, n = in.Get16(); in.ok && i < n; ++i) {
+    uint32_t id = in.Get32();
+    session->contexts.emplace_back(id, in.Get32());
+  }
+  for (uint16_t i = 0, n = in.Get16(); in.ok && i < n; ++i) {
+    Property property;
+    property.id = in.Get32();
+    property.value.resize(in.Get16());
+    in.Take(property.value.data(), property.value.size());
+    session->properties.push_back(std::move(property));
+  }
+  session->qos.resize(in.Get16());
+  in.Take(session->qos.data(), session->qos.size());
+  return in.ok;
+}
+
+struct State {
+  std::mutex mutex;
+  bool hosting = false;
+  Session hosted;
+  std::vector<std::pair<uint32_t, uint32_t>> contexts;
+  std::vector<Property> properties;
+  std::vector<uint8_t> qos;
+  std::unordered_map<uint32_t, std::vector<uint8_t>> found_qos;      // by host IP
+  std::unordered_map<uint32_t, std::vector<uint8_t>> known_xnaddrs;  // by IP
+  std::atomic<bool> lobby_started{false};
+};
+
+State& state() {
+  static State* instance = new State;
+  return *instance;
+}
+
+// Answers lobby queries while netplay is on: with the hosted session, if any.
+void LobbyThread() {
+  socket_t s = OpenUdpSocket();
+  int yes = 1;
+  setsockopt(s, SOL_SOCKET, SO_REUSEADDR, reinterpret_cast<const char*>(&yes), sizeof(yes));
+  setsockopt(s, SOL_SOCKET, SO_BROADCAST, reinterpret_cast<const char*>(&yes), sizeof(yes));
+  sockaddr_in address = SocketAddress(INADDR_ANY, uint16_t(REXCVAR_GET(netplay_port)));
+  if (bind(s, reinterpret_cast<sockaddr*>(&address), sizeof(address)) != 0) {
+    REXKRNL_ERROR("[netplay] lobby: can't use UDP port {}; others won't find sessions hosted here",
+                  REXCVAR_GET(netplay_port));
+    NETPLAY_CLOSE(s);
+    return;
+  }
+  REXKRNL_INFO("[netplay] lobby listening on UDP port {}, this machine is {}",
+               REXCVAR_GET(netplay_port), IpText(LocalIp()));
+  uint8_t buffer[2048];
+  for (;;) {
+    sockaddr_in from{};
+    socklen_t from_size = sizeof(from);
+    int received = int(recvfrom(s, reinterpret_cast<char*>(buffer), sizeof(buffer), 0,
+                                reinterpret_cast<sockaddr*>(&from), &from_size));
+    if (received < 4 || std::memcmp(buffer, kQuery, 4) != 0) {
+      continue;
+    }
+    std::vector<uint8_t> answer;
+    {
+      std::lock_guard<std::mutex> lock(state().mutex);
+      if (!state().hosting) {
+        continue;
+      }
+      Session session = state().hosted;
+      session.contexts = state().contexts;
+      session.properties = state().properties;
+      session.qos = state().qos;
+      answer = Encode(session);
+    }
+    sendto(s, reinterpret_cast<const char*>(answer.data()), int(answer.size()), 0,
+           reinterpret_cast<sockaddr*>(&from), from_size);
+    REXKRNL_INFO("[netplay] lobby: told {} about the session hosted here",
+                 IpText(ntohl(from.sin_addr.s_addr)));
+  }
+}
+
+void StartLobby() {
+  if (!state().lobby_started.exchange(true)) {
+    std::thread(LobbyThread).detach();
+  }
+}
+
+}  // namespace
+
+uint32_t LocalIp() {
+  static const uint32_t ip = [] {
+    // The address the system would send from towards the peer (or the
+    // internet): the interface the other player reaches, not a VPN's.
+    uint32_t target = ParseIp(REXCVAR_GET(netplay_peer));
+    if (!target) {
+      target = 0x08080808;
+    }
+    socket_t s = OpenUdpSocket();
+    sockaddr_in address = SocketAddress(target, 53);
+    uint32_t local = INADDR_LOOPBACK;
+    if (connect(s, reinterpret_cast<sockaddr*>(&address), sizeof(address)) == 0) {
+      sockaddr_in name{};
+      socklen_t size = sizeof(name);
+      if (getsockname(s, reinterpret_cast<sockaddr*>(&name), &size) == 0) {
+        local = ntohl(name.sin_addr.s_addr);
+      }
+    }
+    NETPLAY_CLOSE(s);
+    return local;
+  }();
+  return ip;
+}
+
+uint64_t Random64() {
+  static std::mutex mutex;
+  static std::mt19937_64 generator{[] {
+    std::random_device device;
+    return (uint64_t(device()) << 32) ^ device() ^
+           uint64_t(std::chrono::steady_clock::now().time_since_epoch().count());
+  }()};
+  std::lock_guard<std::mutex> lock(mutex);
+  return generator();
+}
+
+uint64_t OnlineXuid() {
+  // Online XUIDs start 0009; bits 54-55 must stay clear.
+  static const uint64_t xuid = 0x0009000000000000ull | (Random64() & 0x0000FFFFFFFFFFFFull);
+  return xuid;
+}
+
+void FillXnAddr(uint8_t* xnaddr) {
+  StartLobby();
+  static const uint64_t machine = Random64();
+  uint32_t ip = htonl(LocalIp());
+  std::memset(xnaddr, 0, kXnAddrSize);
+  std::memcpy(xnaddr + 0, &ip, 4);  // ina
+  std::memcpy(xnaddr + 4, &ip, 4);  // inaOnline
+  uint16_t port = htons(uint16_t(REXCVAR_GET(netplay_port)));
+  std::memcpy(xnaddr + 8, &port, 2);  // wPortOnline
+  // abEnet: a locally administered MAC; abOnline: this copy's id.
+  xnaddr[10] = 0x02;
+  for (int i = 1; i < 6; ++i) {
+    xnaddr[10 + i] = uint8_t(machine >> (8 * i));
+  }
+  for (int i = 0; i < 8; ++i) {
+    xnaddr[16 + i] = uint8_t(machine >> (8 * i));
+  }
+  std::memcpy(xnaddr + 24, &ip, 4);
+}
+
+uint32_t XnAddrIp(const uint8_t* xnaddr) {
+  uint32_t ip;
+  std::memcpy(&ip, xnaddr, 4);
+  return ntohl(ip);
+}
+
+uint16_t HostPort(uint16_t guest_port) {
+  return guest_port ? uint16_t(guest_port + REXCVAR_GET(netplay_port_offset)) : 0;
+}
+
+uint16_t GuestPort(uint16_t host_port) {
+  uint32_t offset = REXCVAR_GET(netplay_port_offset);
+  return host_port > offset ? uint16_t(host_port - offset) : host_port;
+}
+
+void SetContext(uint32_t id, uint32_t value) {
+  std::lock_guard<std::mutex> lock(state().mutex);
+  auto& contexts = state().contexts;
+  auto it = std::find_if(contexts.begin(), contexts.end(),
+                         [id](const auto& context) { return context.first == id; });
+  if (it != contexts.end()) {
+    it->second = value;
+  } else {
+    contexts.emplace_back(id, value);
+  }
+}
+
+void SetProperty(uint32_t id, const uint8_t* value, uint32_t size) {
+  std::lock_guard<std::mutex> lock(state().mutex);
+  auto& properties = state().properties;
+  auto it = std::find_if(properties.begin(), properties.end(),
+                         [id](const Property& property) { return property.id == id; });
+  if (it == properties.end()) {
+    properties.push_back({id, {}});
+    it = properties.end() - 1;
+  }
+  it->value.assign(value, value + std::min<uint32_t>(size, 256));
+}
+
+void SetQosData(const uint8_t* data, uint32_t size) {
+  std::lock_guard<std::mutex> lock(state().mutex);
+  state().qos.assign(data, data + std::min<uint32_t>(size, 1024));
+}
+
+void Host(const Session& session) {
+  StartLobby();
+  std::lock_guard<std::mutex> lock(state().mutex);
+  state().hosted = session;
+  state().hosting = true;
+}
+
+void SetFilledSlots(uint32_t filled_public, uint32_t filled_private) {
+  std::lock_guard<std::mutex> lock(state().mutex);
+  state().hosted.filled_public = filled_public;
+  state().hosted.filled_private = filled_private;
+}
+
+void StopHosting() {
+  std::lock_guard<std::mutex> lock(state().mutex);
+  state().hosting = false;
+}
+
+std::vector<Session> Search() {
+  StartLobby();
+  std::vector<Session> found;
+  socket_t s = OpenUdpSocket();
+  int yes = 1;
+  setsockopt(s, SOL_SOCKET, SO_BROADCAST, reinterpret_cast<const char*>(&yes), sizeof(yes));
+  SetReceiveTimeout(s, 200);
+  uint16_t port = uint16_t(REXCVAR_GET(netplay_port));
+  uint32_t peer = ParseIp(REXCVAR_GET(netplay_peer));
+  uint32_t self = LocalIp();
+  auto ask = [&] {
+    if (peer) {
+      sockaddr_in to = SocketAddress(peer, port);
+      sendto(s, reinterpret_cast<const char*>(kQuery), 4, 0, reinterpret_cast<sockaddr*>(&to),
+             sizeof(to));
+    }
+    sockaddr_in everyone = SocketAddress(INADDR_BROADCAST, port);
+    sendto(s, reinterpret_cast<const char*>(kQuery), 4, 0,
+           reinterpret_cast<sockaddr*>(&everyone), sizeof(everyone));
+  };
+  auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(1000);
+  auto next_ask = std::chrono::steady_clock::now();
+  uint8_t buffer[2048];
+  while (std::chrono::steady_clock::now() < deadline) {
+    if (std::chrono::steady_clock::now() >= next_ask) {
+      ask();  // a few times, in case a packet is lost
+      next_ask += std::chrono::milliseconds(300);
+    }
+    sockaddr_in from{};
+    socklen_t from_size = sizeof(from);
+    int received = int(recvfrom(s, reinterpret_cast<char*>(buffer), sizeof(buffer), 0,
+                                reinterpret_cast<sockaddr*>(&from), &from_size));
+    Session session;
+    if (received <= 0 || !Decode(buffer, size_t(received), &session)) {
+      continue;
+    }
+    uint32_t from_ip = ntohl(from.sin_addr.s_addr);
+    if (from_ip == self) {
+      continue;  // our own session, through the broadcast
+    }
+    // The host as we reach it: its answer's source address.
+    uint32_t ip = htonl(from_ip);
+    std::memcpy(session.info + kXnKidSize + 0, &ip, 4);
+    std::memcpy(session.info + kXnKidSize + 4, &ip, 4);
+    bool duplicate = std::any_of(found.begin(), found.end(), [&](const Session& other) {
+      return std::memcmp(other.info, session.info, kXnKidSize) == 0;
+    });
+    if (duplicate) {
+      continue;
+    }
+    RememberXnAddr(session.info + kXnKidSize);
+    {
+      std::lock_guard<std::mutex> lock(state().mutex);
+      state().found_qos[from_ip] = session.qos;
+    }
+    REXKRNL_INFO("[netplay] found a session hosted by {} ({}/{} public slots filled)",
+                 IpText(from_ip), session.filled_public, session.max_public);
+    found.push_back(std::move(session));
+  }
+  NETPLAY_CLOSE(s);
+  return found;
+}
+
+bool FoundQosData(uint32_t host_ip, std::vector<uint8_t>* data) {
+  std::lock_guard<std::mutex> lock(state().mutex);
+  auto it = state().found_qos.find(host_ip);
+  if (it == state().found_qos.end()) {
+    return false;
+  }
+  *data = it->second;
+  return true;
+}
+
+void RememberXnAddr(const uint8_t* xnaddr) {
+  std::lock_guard<std::mutex> lock(state().mutex);
+  state().known_xnaddrs[XnAddrIp(xnaddr)].assign(xnaddr, xnaddr + kXnAddrSize);
+}
+
+bool XnAddrForIp(uint32_t ip, uint8_t* xnaddr) {
+  if (ip == LocalIp()) {
+    FillXnAddr(xnaddr);
+    return true;
+  }
+  std::lock_guard<std::mutex> lock(state().mutex);
+  auto it = state().known_xnaddrs.find(ip);
+  if (it == state().known_xnaddrs.end()) {
+    return false;
+  }
+  std::memcpy(xnaddr, it->second.data(), kXnAddrSize);
+  return true;
+}
