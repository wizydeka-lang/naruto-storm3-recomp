+  }
+  if (event_handle) {
+    auto ev = REX_KERNEL_OBJECTS()->LookupObject<XEvent>(event_handle);
+    if (ev) {
+      ev->Set(0, false);
+    }
+  }
+  REX_NETPLAY_LOG("XNetQosLookup({} hosts, {} addresses) -> {} bytes of host data", count,
+                  ina_count, data_total);
