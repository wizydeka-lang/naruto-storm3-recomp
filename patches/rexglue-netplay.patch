+    auto* xnaddr = REX_KERNEL_MEMORY()->TranslateVirtual<uint8_t*>(xnaddr_ptr);
+    contacted[i] = xnaddr_ptr && netplay::FoundQosData(netplay::XnAddrIp(xnaddr), &data[i]);
