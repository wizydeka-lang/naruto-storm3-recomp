diff --git a/src/core/fiber_posix.cpp b/src/core/fiber_posix.cpp
index 4fe1ca6..d0a87d5 100644
--- a/src/core/fiber_posix.cpp
+++ b/src/core/fiber_posix.cpp
@@ -17,7 +17,135 @@
 #endif
 
 #include <rex/platform.h>
-#if REX_PLATFORM_LINUX || REX_PLATFORM_MAC
+#if REX_PLATFORM_ANDROID
+
+#include <rex/thread/fiber.h>
+
+#include <cassert>
+#include <cstring>
+
+#if !defined(__aarch64__)
+#error Android fibers are only implemented for arm64.
+#endif
+
+// rex_fiber_switch(void** from_sp, void* to_sp): pushes the AAPCS64
+// callee-saved registers (x19-x30, d8-d15) onto the current stack, stores the
+// stack pointer to *from_sp, then loads to_sp and pops the same frame from it.
+// The final ret jumps to the restored x30.
+//
+// rex_fiber_start is the x30 of a new fiber's first frame; x19 of that frame
+// holds the function to run, which must not return.
+asm(R"(
+    .text
+    .p2align 2
+    .globl rex_fiber_switch
+    .hidden rex_fiber_switch
+    .type rex_fiber_switch, %function
+rex_fiber_switch:
+    sub sp, sp, #160
+    stp x19, x20, [sp, #0]
+    stp x21, x22, [sp, #16]
+    stp x23, x24, [sp, #32]
+    stp x25, x26, [sp, #48]
+    stp x27, x28, [sp, #64]
+    stp x29, x30, [sp, #80]
+    stp d8, d9, [sp, #96]
+    stp d10, d11, [sp, #112]
+    stp d12, d13, [sp, #128]
+    stp d14, d15, [sp, #144]
+    mov x9, sp
+    str x9, [x0]
+    mov sp, x1
+    ldp x19, x20, [sp, #0]
+    ldp x21, x22, [sp, #16]
+    ldp x23, x24, [sp, #32]
+    ldp x25, x26, [sp, #48]
+    ldp x27, x28, [sp, #64]
+    ldp x29, x30, [sp, #80]
+    ldp d8, d9, [sp, #96]
+    ldp d10, d11, [sp, #112]
+    ldp d12, d13, [sp, #128]
+    ldp d14, d15, [sp, #144]
+    add sp, sp, #160
+    ret
+    .size rex_fiber_switch, . - rex_fiber_switch
+
+    .p2align 2
+    .globl rex_fiber_start
+    .hidden rex_fiber_start
+    .type rex_fiber_start, %function
+rex_fiber_start:
+    mov x29, xzr
+    blr x19
+    brk #0x3e8
+    .size rex_fiber_start, . - rex_fiber_start
+)");
+
+extern "C" void rex_fiber_switch(void** from_sp, void* to_sp);
+extern "C" void rex_fiber_start();
+
+namespace rex::thread {
+
+namespace {
+constexpr size_t kSwitchFrameSize = 160;
+constexpr size_t kSwitchFrameX19 = 0;
+constexpr size_t kSwitchFrameX30 = 88;
+}  // namespace
+
+thread_local Fiber* Fiber::tls_current_ = nullptr;
+
+Fiber* Fiber::ConvertCurrentThread() {
+  // The thread's stack pointer is saved by the first SwitchTo away from it.
+  auto* f = new Fiber();
+  f->is_thread_fiber_ = true;
+  tls_current_ = f;
+  return f;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  auto* f = new Fiber();
+  f->entry_ = entry;
+  f->arg_ = arg;
+  f->stack_.resize(stack_size);
+
+  // A first switch frame at the 16-byte aligned top of the stack: zeroed
+  // registers, except x19 = Trampoline and x30 = rex_fiber_start.
+  auto top = reinterpret_cast<uintptr_t>(f->stack_.data() + f->stack_.size()) & ~uintptr_t(15);
+  auto* frame = reinterpret_cast<uint8_t*>(top - kSwitchFrameSize);
+  std::memset(frame, 0, kSwitchFrameSize);
+  auto trampoline = reinterpret_cast<uintptr_t>(&Fiber::Trampoline);
+  auto start = reinterpret_cast<uintptr_t>(&rex_fiber_start);
+  std::memcpy(frame + kSwitchFrameX19, &trampoline, sizeof(trampoline));
+  std::memcpy(frame + kSwitchFrameX30, &start, sizeof(start));
+  f->sp_ = frame;
+  return f;
+}
+
+/*static*/ void Fiber::Trampoline() {
+  // tls_current_ was updated by SwitchTo before rex_fiber_switch entered here.
+  Fiber* f = tls_current_;
+  f->entry_(f->arg_);
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  Fiber* from = tls_current_;
+  tls_current_ = target;
+  rex_fiber_switch(&from->sp_, target->sp_);
+}
+
+void Fiber::Destroy() {
+  // Thread fibers are destroyed from the owning thread itself.
+  if (is_thread_fiber_) {
+    tls_current_ = nullptr;
+  } else {
+    assert(this != tls_current_ && "Destroy called on the currently running fiber");
+  }
+  delete this;
+}
+
+}  // namespace rex::thread
+
+#elif REX_PLATFORM_LINUX || REX_PLATFORM_MAC
 
 #include <rex/thread/fiber.h>
 
