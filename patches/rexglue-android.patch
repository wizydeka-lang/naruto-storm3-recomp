+#if REX_PLATFORM_ANDROID
+bool IsAndroidContentUri(const std::string_view source) {
+  return source.starts_with("content://");
+}
+
+int OpenAndroidContentFileDescriptor(const std::string_view uri, const char* mode) {
+  // ContentResolver.openFileDescriptor(Uri.parse(uri), mode).detachFd(), with
+  // the activity from SDL. Java exceptions (missing permission, no such file)
+  // become -1.
+  auto* env = static_cast<JNIEnv*>(SDL_GetAndroidJNIEnv());
+  if (!env || env->PushLocalFrame(16) != JNI_OK) {
+    return -1;
+  }
+  int file_descriptor = -1;
+  auto activity = static_cast<jobject>(SDL_GetAndroidActivity());
+  if (activity) {
+    jclass context_class = env->FindClass("android/content/Context");
+    jclass resolver_class = env->FindClass("android/content/ContentResolver");
+    jclass uri_class = env->FindClass("android/net/Uri");
+    jclass pfd_class = env->FindClass("android/os/ParcelFileDescriptor");
+    if (context_class && resolver_class && uri_class && pfd_class) {
+      jmethodID get_content_resolver = env->GetMethodID(
+          context_class, "getContentResolver", "()Landroid/content/ContentResolver;");
+      jmethodID parse =
+          env->GetStaticMethodID(uri_class, "parse", "(Ljava/lang/String;)Landroid/net/Uri;");
+      jmethodID open_file_descriptor =
+          env->GetMethodID(resolver_class, "openFileDescriptor",
+                           "(Landroid/net/Uri;Ljava/lang/String;)Landroid/os/ParcelFileDescriptor;");
+      jmethodID detach_fd = env->GetMethodID(pfd_class, "detachFd", "()I");
+      jobject resolver = env->CallObjectMethod(activity, get_content_resolver);
+      jstring uri_string = env->NewStringUTF(std::string(uri).c_str());
+      jobject parsed_uri =
+          resolver && uri_string ? env->CallStaticObjectMethod(uri_class, parse, uri_string)
+                                 : nullptr;
+      jstring mode_string = parsed_uri ? env->NewStringUTF(mode) : nullptr;
+      jobject pfd = mode_string ? env->CallObjectMethod(resolver, open_file_descriptor,
+                                                        parsed_uri, mode_string)
+                                : nullptr;
+      if (pfd && !env->ExceptionCheck()) {
+        file_descriptor = env->CallIntMethod(pfd, detach_fd);
+      }
+    }
+  }
+  if (env->ExceptionCheck()) {
+    env->ExceptionClear();
+    file_descriptor = -1;
+  }
+  env->PopLocalFrame(nullptr);
+  return file_descriptor;
+}
+#endif  // REX_PLATFORM_ANDROID
+
 }  // namespace filesystem
 }  // namespace rex
